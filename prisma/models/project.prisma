enum ProjectStatus {
  DRAFT
  ARCHIVED
}

model Project {
  id                String        @id @default(cuid())
  ownerId           String
  name              String
  description       String?
  status            ProjectStatus @default(DRAFT)
  canvasJsonPath    String?
  // Latest Discovery-composed brief, overwritten on each Generate. A single
  // current value (like canvasJsonPath), not a history like ProjectSpec.
  architectureBrief String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  collaborators ProjectCollaborator[]
  specs         ProjectSpec[]

  @@index([ownerId])
  @@index([createdAt])
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  email     String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}
